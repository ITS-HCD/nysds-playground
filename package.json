{
  "name": "nysds-playground",
  "version": "0.1.0",
  "description": "A browser playground for the New York State Design System.",
  "scripts": {
    "start": "node bin/cli.mjs",
    "present": "node bin/cli.mjs --present",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts bin/*.test.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@nysds/components": "1.21.0",
    "@nysds/styles": "1.21.0",
    "idb-keyval": "6.2.2",
    "lz-string": "1.5.0",
    "playground-elements": "0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "private": true,
  "bin": {
    "nysds-playground": "bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "presets",
    "decks",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20"
  }
}
