{
  "title": "Icon list and divider",
  "description": "Icon lists with a second line of text and rules between items, and dividers that separate sections.",
  "html": "<h1 class=\"nys-font-h3\">Icon list and divider</h1>\n\n<div class=\"nys-grid-row nys-grid-gap-400\">\n  <div class=\"nys-grid-col-12 nys-desktop:nys-grid-col-8\">\n    <h2 class=\"nys-font-h5\">Icon list</h2>\n    <div class=\"nys-grid-row nys-grid-gap-400\">\n      <div class=\"nys-grid-col-12 nys-tablet:nys-grid-col-6\">\n        <h3 class=\"nys-font-h6 nys-margin-b-200\">Bring these documents</h3>\n        <nys-iconlist>\n          <nys-iconlistitem icon=\"check_circle\">Recent pay stubs</nys-iconlistitem>\n          <nys-iconlistitem icon=\"check_circle\">Current property tax bill</nys-iconlistitem>\n          <nys-iconlistitem icon=\"check_circle\">Social Security card</nys-iconlistitem>\n        </nys-iconlist>\n      </div>\n      <div class=\"nys-grid-col-12 nys-tablet:nys-grid-col-6\">\n        <h3 class=\"nys-font-h6 nys-margin-b-200\">Information session</h3>\n        <nys-iconlist divider>\n          <nys-iconlistitem icon=\"calendar_month\">December 10, 2026</nys-iconlistitem>\n          <nys-iconlistitem icon=\"schedule\">\n            5:00 PM\n            <span slot=\"secondary\">Eastern Time</span>\n          </nys-iconlistitem>\n          <nys-iconlistitem icon=\"location_on\">\n            Empire State Plaza\n            <span slot=\"secondary\">Albany, NY</span>\n          </nys-iconlistitem>\n        </nys-iconlist>\n      </div>\n    </div>\n  </div>\n  <div class=\"nys-grid-col-12 nys-desktop:nys-grid-col-4\">\n    <h2 class=\"nys-font-h5\">Divider</h2>\n    <p>Bring a photo ID to the session.</p>\n    <!-- nys-divider ignores margin classes (ITS-HCD/nysds#1911), so a wrapper spaces it. -->\n    <div class=\"nys-padding-y-300\">\n      <nys-divider></nys-divider>\n    </div>\n    <p>Can't attend? A recording goes online the next day.</p>\n    <div class=\"nys-padding-y-300\">\n      <nys-divider subtle></nys-divider>\n    </div>\n    <p>Questions? Contact the program office.</p>\n  </div>\n</div>\n\n<p class=\"nys-font-body-sm nys-margin-t-500\">Docs: <a href=\"https://designsystem.ny.gov/components/iconlist/\" target=\"_blank\" rel=\"noopener\">Icon list</a> · <a href=\"https://designsystem.ny.gov/components/divider/\" target=\"_blank\" rel=\"noopener\">Divider</a></p>\n",
  "css": "",
  "js": ""
}
