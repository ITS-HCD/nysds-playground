{
  "title": "Agency themes",
  "description": "Buttons and form controls take on each agency theme, while alerts keep their semantic colors.",
  "html": "<nys-select id=\"theme-select\" label=\"Select an agency theme\">\n  <option value=\"default\" label=\"Default (NY.gov)\" selected></option>\n  <option value=\"admin\" label=\"Administration\"></option>\n  <option value=\"business\" label=\"Business\"></option>\n  <option value=\"environment\" label=\"Environment\"></option>\n  <option value=\"health\" label=\"Health\"></option>\n  <option value=\"local\" label=\"Local Government\"></option>\n  <option value=\"safety\" label=\"Public Safety\"></option>\n  <option value=\"transportation\" label=\"Transportation\"></option>\n</nys-select>\n\n<div id=\"theme-wrapper\">\n  <div class=\"nys-display-flex nys-flex-column nys-flex-gap-300 nys-margin-t-300\">\n    <div class=\"nys-display-flex nys-flex-wrap nys-flex-gap-200\">\n      <nys-button label=\"Primary action\"></nys-button>\n      <nys-button label=\"Secondary action\" variant=\"outline\"></nys-button>\n    </div>\n    <nys-toggle label=\"The theme colors this toggle\" checked></nys-toggle>\n    <nys-checkbox label=\"And this checkbox\" checked></nys-checkbox>\n    <nys-alert type=\"info\" heading=\"Semantic colors stay the same\" text=\"Alerts keep their semantic colors in every theme, so their meaning doesn't change.\"></nys-alert>\n  </div>\n</div>\n\n<p class=\"nys-font-body-sm nys-margin-t-500\"><a href=\"https://designsystem.ny.gov/foundations/themes/\" target=\"_blank\" rel=\"noopener\">Themes docs</a></p>\n",
  "css": "",
  "js": "const themeSelect = document.getElementById('theme-select');\nconst themeWrapper = document.getElementById('theme-wrapper');\n\nthemeSelect.addEventListener('nys-change', (e) => {\n  // The wrapper carries one nys-theme-* class at a time. No class means the\n  // default NY.gov theme.\n  themeWrapper.className = e.detail.value === 'default' ? '' : `nys-theme-${e.detail.value}`;\n});\n"
}
