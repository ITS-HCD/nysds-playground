{
  "title": "Tooltip and dropdown menu",
  "description": "A tooltip with extra detail about a button, and a dropdown menu of account actions.",
  "html": "<div class=\"nys-margin-b-400\">\n  <nys-button id=\"download-button\" label=\"Download the form\" variant=\"outline\" prefixIcon=\"download\"></nys-button>\n  <nys-tooltip for=\"download-button\" text=\"PDF, about 200 KB\"></nys-tooltip>\n</div>\n\n<nys-button id=\"menu-trigger\" label=\"Account\" suffixIcon=\"chevron_down\"></nys-button>\n<nys-dropdownmenu id=\"account-menu\" for=\"menu-trigger\" label=\"Account\">\n  <nys-dropdownmenuitem label=\"Profile\" href=\"#profile\"></nys-dropdownmenuitem>\n  <nys-dropdownmenuitem label=\"Settings\" href=\"#settings\"></nys-dropdownmenuitem>\n  <nys-dropdownmenuitem label=\"Sign out\" href=\"#sign-out\"></nys-dropdownmenuitem>\n</nys-dropdownmenu>\n\n<p class=\"nys-font-body-sm nys-margin-t-500\">Docs: <a href=\"https://designsystem.ny.gov/components/tooltip/\" target=\"_blank\" rel=\"noopener\">Tooltip</a> · <a href=\"https://designsystem.ny.gov/components/dropdownmenu/\" target=\"_blank\" rel=\"noopener\">Dropdown menu</a></p>\n",
  "css": "",
  "js": ""
}
